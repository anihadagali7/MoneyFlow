# Copy to .env.local for development. Never commit real values.

# Postgres (Neon recommended). Needs PG 15+.
DATABASE_URL=postgres://user:password@host/moneyflow?sslmode=require
# Vercel Production only: the DIRECT (unpooled) URL. Production builds apply migrations with it.
MIGRATION_DATABASE_URL=

# Clerk. Leave unset in development to use Clerk's keyless mode.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Encryption master key (PLAN.md §4)
# local: master key from LOCAL_MASTER_KEY (generate with: openssl rand -base64 32)
# aws:   AWS KMS key; also set AWS_REGION and AWS credentials
KEY_PROVIDER=local
LOCAL_MASTER_KEY=
# Required to use KEY_PROVIDER=local when NODE_ENV=production
ALLOW_LOCAL_KEY_PROVIDER=false
KMS_KEY_ID=
AWS_REGION=

# Plaid (Phase 1). Sandbox keys first; Trial plan keys use PLAID_ENV=production.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Public URL of /api/webhooks/plaid (set after deploying; webhooks can't reach localhost)
PLAID_WEBHOOK_URL=

# Daily catch-up sync (vercel.json cron). Any long random string; Vercel sends it automatically.
CRON_SECRET=

# Claude API (Phase 1, categorization)
ANTHROPIC_API_KEY=

# Feedback → GitHub issues (optional): "owner/name" (issues there are public) and a
# fine-grained token for that repo only with Issues: Read and write.
GITHUB_FEEDBACK_REPO=
GITHUB_FEEDBACK_TOKEN=
